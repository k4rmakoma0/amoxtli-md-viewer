    "Otra app modificó o movió este archivo y aquí hay cambios sin guardar. Elige qué versión conservar." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine andere App hat diese Datei geändert oder bewegt, und hier gibt es nicht gesicherte Änderungen. Wähle, welche Version du behalten möchtest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another app changed or moved this file, and there are unsaved changes here. Choose which version to keep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otra app modificó o movió este archivo y aquí hay cambios sin guardar. Elige qué versión conservar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une autre app a modifié ou déplacé ce fichier, et il y a ici des modifications non enregistrées. Choisissez la version à conserver."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un’altra app ha modificato o spostato questo file e qui ci sono modifiche non salvate. Scegli quale versione mantenere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のAppがこのファイルを変更または移動しました。ここには保存されていない変更があります。残すバージョンを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 앱이 이 파일을 변경하거나 이동했으며 여기에 저장되지 않은 변경 사항이 있습니다. 유지할 버전을 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outro app alterou ou moveu este arquivo, e há alterações não salvas aqui. Escolha qual versão manter."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Другое приложение изменило или переместило этот файл, а здесь есть несохраненные изменения. Выберите, какую версию оставить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一个 App 更改或移动了此文件，而这里有未存储的更改。请选择要保留的版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一個 App 變更或移動了此檔案，而這裡有未儲存的變更。請選擇要保留的版本。"
          }
        }
      }
    },
