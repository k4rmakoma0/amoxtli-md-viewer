    "Comprueba que tengas permiso para escribir en «%@». Si abriste esta carpeta con una versión anterior de Amoxtli, vuelve a abrirla." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe, ob du Schreibrechte für „%@“ hast. Wenn du diesen Ordner mit einer älteren Version von Amoxtli geöffnet hast, öffne ihn erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check that you have permission to write to “%@”. If you opened this folder with an earlier version of Amoxtli, open it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba que tengas permiso para escribir en «%@». Si abriste esta carpeta con una versión anterior de Amoxtli, vuelve a abrirla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez que vous avez l’autorisation d’écrire dans « %@ ». Si vous avez ouvert ce dossier avec une version antérieure d’Amoxtli, ouvrez-le à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica di avere il permesso di scrivere in “%@”. Se hai aperto questa cartella con una versione precedente di Amoxtli, aprila di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”への書き込み権限があることを確認してください。以前のバージョンのAmoxtliでこのフォルダを開いた場合は、もう一度開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’에 쓸 수 있는 권한이 있는지 확인하십시오. 이전 버전의 Amoxtli로 이 폴더를 열었다면 다시 여십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique se você tem permissão para escrever em “%@”. Se você abriu esta pasta com uma versão anterior do Amoxtli, abra-a novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убедитесь, что у Вас есть разрешение на запись в «%@». Если Вы открыли эту папку в более ранней версии Amoxtli, откройте ее снова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查你是否有权限写入“%@”。如果你是用较早版本的 Amoxtli 打开此文件夹的，请重新打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請檢查你是否有權限寫入「%@」。如果你是用較早版本的 Amoxtli 打開此檔案夾，請重新打開。"
          }
        }
      }
    },
